{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Board Game Therapy catalog",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "updatedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "src": {
            "type": "string",
            "pattern": "^/(?:evidence/)?[a-zA-Z0-9_.-]+\\.(?:jpe?g|png|webp)$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "filename": {
            "type": "string",
            "minLength": 1
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "addedAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": [
          "id",
          "src",
          "label",
          "filename",
          "width",
          "height"
        ]
      }
    },
    "games": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "maxItems": 20
          },
          "kind": {
            "enum": [
              "game",
              "expansion",
              "accessory",
              "unknown"
            ]
          },
          "confidence": {
            "enum": [
              "confirmed",
              "uncertain"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000
          },
          "notes": {
            "type": "string",
            "maxLength": 3000
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "photoId": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "region": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "width": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 1
                    },
                    "height": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 1
                    }
                  },
                  "required": [
                    "x",
                    "y",
                    "width",
                    "height"
                  ]
                },
                "location": {
                  "type": "string"
                }
              },
              "required": [
                "photoId",
                "region"
              ]
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^https://[^\\s]+$"
            },
            "uniqueItems": true
          },
          "players": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "min": {
                "type": "integer",
                "minimum": 1
              },
              "max": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "min",
              "max"
            ]
          },
          "minutes": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "min": {
                "type": "integer",
                "minimum": 1
              },
              "max": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "min",
              "max"
            ]
          },
          "minAge": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          },
          "image": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "thumbnail": {
                "type": "string",
                "pattern": "^https://[^\\s]+$"
              },
              "full": {
                "type": "string",
                "pattern": "^https://[^\\s]+$"
              },
              "source": {
                "type": "string",
                "pattern": "^https://[^\\s]+$"
              },
              "credit": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "thumbnail",
              "full",
              "source",
              "credit"
            ]
          },
          "reference": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "bggId": {
                "type": "integer",
                "minimum": 1
              },
              "url": {
                "type": "string",
                "pattern": "^https://[^\\s]+$"
              },
              "checkedAt": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            },
            "required": [
              "name",
              "bggId",
              "url",
              "checkedAt"
            ]
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "key",
          "title",
          "tags",
          "kind",
          "confidence",
          "summary",
          "description",
          "notes",
          "evidence",
          "sources"
        ]
      }
    },
    "retiredPlaceholders": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schemaVersion",
    "revision",
    "updatedAt",
    "photos",
    "games"
  ]
}
