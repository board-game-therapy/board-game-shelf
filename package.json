{
  "name": "bgt-game-library",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/catalog.mjs && vite --host 127.0.0.1",
    "build": "node scripts/catalog.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "validate": "node scripts/catalog.mjs --check",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:browser": "playwright test",
    "catalog:import": "node scripts/import-photo.mjs",
    "format": "prettier --write src scripts relay tests vite.config.ts playwright.config.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "lucide-react": "^0.468.0",
    "minisearch": "^7.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "ajv": "^8.17.1",
    "prettier": "^3.6.2",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3",
    "vite": "^7.2.0",
    "wrangler": "^4.141.0",
    "yaml": "^2.8.1"
  }
}
